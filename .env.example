# Copy this file to .env and fill in your values.
# The app works WITHOUT an API key — it falls back to keyword-based
# classification and mock chat responses automatically.

# Optional: set a real OpenAI key to enable GPT-4o-mini
OPENAI_API_KEY=

# Database path (used inside the container — do not change unless you
# also update the volume mount in docker-compose.yml)
DATABASE_URL=sqlite:////data/supportlens.db
